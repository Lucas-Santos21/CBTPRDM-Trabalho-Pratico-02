<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TarefasApp.ModalAdicionar"
             Title="Adicionar Tarefa">

    <!--﻿Nome e prontuário da dupla:
    Lucas da Silva Santos CB3030598
    Kaueh Farias Ferreira dos Santos CB3031438-->
    
    <StackLayout Padding="20" Spacing="15">
        <Label Text="Nova Tarefa" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />

        <Entry x:Name="txtTitulo" Placeholder="Título da tarefa" />
        <Editor x:Name="txtDescricao" Placeholder="Descrição da tarefa" HeightRequest="100" />

        <Label Text="Data de Criação:" FontAttributes="Bold" />
        <DatePicker x:Name="dpData" />

        <Label Text="Prioridade:" FontAttributes="Bold" />
        <Picker x:Name="pckPrioridade" Title="Selecione a prioridade">
            <Picker.ItemsSource>
                <x:Array Type="{x:Type x:String}">
                    <x:String>Baixa</x:String>
                    <x:String>Média</x:String>
                    <x:String>Alta</x:String>
                </x:Array>
            </Picker.ItemsSource>
        </Picker>

        <Button Text="Salvar Tarefa" Clicked="OnSalvarClicked" BackgroundColor="Green" TextColor="White" />
        <Button Text="Cancelar" Clicked="OnCancelarClicked" BackgroundColor="Gray" TextColor="White" />
    </StackLayout>
</ContentPage>