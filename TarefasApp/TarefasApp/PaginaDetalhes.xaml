<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TarefasApp.PaginaDetalhes"
             Title="Detalhes da Tarefa">

    <!--﻿Nome e prontuário da dupla:
    Lucas da Silva Santos CB3030598
    Kaueh Farias Ferreira dos Santos CB3031438-->

    <StackLayout Padding="20" Spacing="10">
        <Label Text="Título:" FontAttributes="Bold" FontSize="16" />
        <Label x:Name="lblTitulo" FontSize="20" />

        <Label Text="Descrição:" FontAttributes="Bold" FontSize="16" Margin="0,10,0,0" />
        <Label x:Name="lblDescricao" FontSize="16" />

        <Label Text="Data de Criação:" FontAttributes="Bold" FontSize="16" Margin="0,10,0,0" />
        <Label x:Name="lblData" FontSize="16" />

        <Label Text="Prioridade:" FontAttributes="Bold" FontSize="16" Margin="0,10,0,0" />
        <Label x:Name="lblPrioridade" FontSize="16" />

        <StackLayout Orientation="Horizontal" Spacing="15" Margin="0,30,0,0" HorizontalOptions="Center">
            <Button Text="Editar" Clicked="OnEditarClicked" BackgroundColor="#E59400" TextColor="White" WidthRequest="120" />
            <Button Text="Excluir" Clicked="OnExcluirClicked" BackgroundColor="Red" TextColor="White" WidthRequest="120" />
        </StackLayout>
    </StackLayout>
</ContentPage>